---
interface Props { channel: string; label: string; title: string; }
const { channel, label, title } = Astro.props;
---
<div class="section-heading">
  <p class="eyebrow">CH {channel} / {label}</p>
  <h2>{title}</h2>
  <slot />
</div>
<style>.section-heading { margin-bottom: 36px; max-width: 650px; } h2 { margin-bottom: 20px; }</style>
